# Copy to .env for local overrides. docker-compose and the server both read these.

# Postgres (docker-compose creates this db; the API runs migrations + seeds on boot)
POSTGRES_USER=cerbo
POSTGRES_PASSWORD=cerbo
POSTGRES_DB=cerbo_store
DATABASE_URL=postgres://cerbo:cerbo@localhost:5432/cerbo_store

# API
PORT=3000
API_PORT=3000           # host port docker-compose publishes the API on
WEB_PORT=5173           # host port docker-compose publishes the Vite dev server on
NODE_ENV=development
LOG_LEVEL=info

# Web (Vite) — where the SPA reaches the API in dev; empty = same origin (prod single image)
VITE_API_BASE=http://localhost:3000
