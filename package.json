{
  "name": "cerbo-supplement-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cerbo in-house supplement store \u2014 vertical slice (Vue 3 SPA + Fastify API + Postgres)",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspace server && npm test --workspace web",
    "test:integration": "npm run test:integration --workspace server",
    "build": "npm run build --workspace web && npm run build --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
